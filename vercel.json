{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/documentacao-tr/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://209.50.227.133:8099/api/:path*"
    },
    {
      "source": "/fluxos/:path*",
      "destination": "http://209.50.227.133:8099/fluxos/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
